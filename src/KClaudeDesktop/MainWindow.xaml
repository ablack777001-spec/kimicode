<Window x:Class="KClaudeDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KClaude Desktop" Width="1180" Height="780" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1D1C1A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="18,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" Background="{StaticResource AccentBrush}" CornerRadius="12" VerticalAlignment="Center">
                    <TextBlock Text="K" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="KClaude Desktop" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock Text="Claude Code × Kimi K3" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                </StackPanel>
                <Border Grid.Column="3" x:Name="BillingBadge" Background="#26362E" CornerRadius="12" Padding="12,6" VerticalAlignment="Center">
                    <TextBlock x:Name="BillingBadgeText" Text="会员额度 · 默认" Foreground="#BDE8C8" FontWeight="SemiBold" />
                </Border>
                <Button Grid.Column="5" x:Name="UpdateButton" Content="检查更新" Click="UpdateButton_Click" VerticalAlignment="Center" />
                <Button Grid.Column="7" Content="设置与诊断" Click="SettingsButton_Click" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <StackPanel Margin="18">
                    <TextBlock Text="工作目录" FontWeight="SemiBold" Margin="0,0,0,7" />
                    <TextBox x:Name="ProjectPathBox" MinHeight="36" TextWrapping="Wrap" />
                    <Button Content="选择文件夹" Margin="0,8,0,18" Click="BrowseButton_Click" />

                    <TextBlock Text="通道" FontWeight="SemiBold" Margin="0,0,0,7" />
                    <ComboBox x:Name="ProfileCombo" SelectionChanged="ProfileCombo_SelectionChanged">
                        <ComboBoxItem Content="会员 · Kimi Code" Tag="member" />
                        <ComboBoxItem Content="API · 按量计费" Tag="api" />
                    </ComboBox>
                    <TextBlock x:Name="ProfileDetailText" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,18" FontSize="12" />

                    <TextBlock Text="权限模式" FontWeight="SemiBold" Margin="0,0,0,7" />
                    <ComboBox x:Name="PermissionCombo">
                        <ComboBoxItem Content="Plan · 只规划" Tag="plan" />
                        <ComboBoxItem Content="Manual · 手动许可" Tag="manual" />
                        <ComboBoxItem Content="Accept edits · 接受编辑" Tag="acceptEdits" />
                        <ComboBoxItem Content="Auto · 自动判定" Tag="auto" />
                        <ComboBoxItem Content="Don't ask · 不询问" Tag="dontAsk" />
                    </ComboBox>
                    <TextBlock Text="界面不提供跳过全部权限的危险模式。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,16" FontSize="12" />

                    <CheckBox x:Name="ContinueCheck" Content="继续当前目录最近会话" Margin="0,0,0,14" />
                    <Button Content="打开完整交互终端" Click="OpenTerminalButton_Click" />
                    <Button Content="新建界面会话" Margin="0,8,0,0" Click="NewChatButton_Click" />

                    <Border Background="#2A2520" BorderBrush="#514438" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,20,0,0">
                        <TextBlock Text="界面会话通过 Claude Code CLI 运行，支持读取、规划与按所选权限修改项目。不会自动从会员切到按量 API。"
                                   TextWrapping="Wrap" Foreground="#D7C6B8" FontSize="12" />
                    </Border>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" Margin="22,18,22,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="130" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                    <RichTextBox x:Name="MessagesBox" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                 Foreground="{StaticResource TextBrush}" Padding="18" VerticalScrollBarVisibility="Auto"
                                 FontSize="14" IsDocumentEnabled="False" />
                </Border>

                <Border Grid.Row="2" Background="#151412" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="104" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="InputBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 BorderThickness="0" Background="Transparent" FontSize="14"
                                 PreviewKeyDown="InputBox_PreviewKeyDown" ToolTip="Ctrl+Enter 发送" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                            <Button x:Name="SendButton" Content="发送" Style="{StaticResource PrimaryButton}" Click="SendButton_Click" />
                            <Button x:Name="StopButton" Content="停止" Margin="0,8,0,0" IsEnabled="False" Click="StopButton_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#11100F" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <TextBlock x:Name="StatusText" Text="就绪" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                <TextBlock Text="Ctrl+Enter 发送 · Key 仅进入 Claude 子进程" Foreground="#777169" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
